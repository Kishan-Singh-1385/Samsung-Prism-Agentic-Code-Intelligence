        "sample_relevant_document": {
          "id": "d8513",
          "partition": "test",
          "text": "t = int(input())\n# a = list(map(int, input().split()))\nfor _ in range(t):\n    a,b,x,y,n = map(int,input().split())\n    \n    options = []\n    a2 = max(a-n,x)\n    b2 = max(b-(n-(a-a2)),y)\n    options.append(a2*b2)\n    \n    b2 = max(b-n,y)\n    a2 = max(a-(n-(b-b2)),x)\n    options.append(a2*b2)\n    \n    print(min(options))",
